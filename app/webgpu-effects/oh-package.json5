  "bugs": "https://github.com/virg00/webgpu-effects/issues",
  "keywords": ["webgpu", "wgsl", "vulkan", "shader", "gpu", "effects", "gradient", "animation", "arkui", "harmonyos"],
  "tags": ["graphics", "animation", "ui"],
  "dependencies": {
    "libwebgpu_effects.so": "file:./src/main/cpp/types/libwebgpu_effects"
  }
}
