diff --git a/src/logging.rs b/src/logging.rs
index f396750..3e044dd 100644
--- a/src/logging.rs
+++ b/src/logging.rs
@@ -81,6 +81,13 @@ pub extern "C" fn wgpuSetLogCallback(
     if !logger.initialized {
         logger.initialized = true;
         log::set_logger(&Logger).unwrap();
+        // Panics abort the host process; route the message through the log callback first so
+        // platforms without a visible stderr (OpenHarmony) still see why.
+        let previous = std::panic::take_hook();
+        std::panic::set_hook(Box::new(move |info| {
+            log::error!("panic: {info}");
+            previous(info);
+        }));
         if log::max_level() == LevelFilter::Off {
             log::set_max_level(LevelFilter::Warn);
         }
